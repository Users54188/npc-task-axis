.timer { text-align: center; }

.mode-pills { display: flex; justify-content: center; gap: 14rpx; }
.pill {
  padding: 10rpx 26rpx; border-radius: 999rpx; background: #EFEFF4;
  color: #6B6A75; font-size: 23rpx;
}
.pill.on { background: #6C4BE8; color: #fff; font-weight: 700; }

.clock { font-size: 96rpx; font-weight: 800; letter-spacing: -4rpx; margin-top: 26rpx; line-height: 1.1; }
.clock-l { margin-top: 4rpx; }

.track {
  height: 14rpx; border-radius: 999rpx; background: #EFEBFF;
  overflow: hidden; margin: 26rpx 0 8rpx;
}
.track .fill { display: block; height: 100%; background: linear-gradient(90deg, #6C4BE8, #8E6BFF); }

.acts { display: flex; gap: 16rpx; margin-top: 26rpx; }
.act {
  flex: 1; padding: 22rpx 0; border-radius: 18rpx; font-size: 25rpx; font-weight: 700;
  background: #F4F5F8; color: #6B6A75;
}
.act.main { background: linear-gradient(135deg, #6C4BE8, #8E6BFF); color: #fff; }

.chips { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip {
  padding: 8rpx 20rpx; margin: 0 12rpx 12rpx 0; border-radius: 999rpx;
  background: #F4F5F8; color: #6B6A75; font-size: 22rpx;
}
.chip-on { background: #6C4BE8; color: #fff; font-weight: 700; }
.chip.add { background: #fff; border: 2rpx dashed #DCD4FF; color: #6C4BE8; }

.kv { display: flex; justify-content: space-between; font-size: 23rpx; padding: 12rpx 0; border-top: 2rpx solid #F4F3F8; }
.kv:first-of-type { border-top: none; }

.note {
  margin-top: 24rpx; padding: 20rpx 24rpx; background: #EFEBFF; border-radius: 18rpx;
  font-size: 21rpx; color: #6B6A75; line-height: 1.75;
}
