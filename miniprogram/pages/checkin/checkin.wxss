.mnav { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14rpx; }
.marrow { color: #6C4BE8; font-size: 24rpx; font-weight: 700; padding: 6rpx 16rpx; }
.mtitle { font-size: 25rpx; font-weight: 700; }

.wk { display: flex; }
.wkc { flex: 1; text-align: center; font-size: 20rpx; color: #9A98A3; padding-bottom: 6rpx; }

.cal { display: flex; flex-wrap: wrap; }
.cell {
  width: 14.28%; height: 72rpx; display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; color: #9A98A3;
}
/* 模板里格子里是 <text>，药丸样式必须落在它身上，否则底色会铺满整格连成横带 */
.cell text {
  width: 52rpx; height: 52rpx; line-height: 52rpx; text-align: center;
  border-radius: 14rpx; display: block;
}
.c-ok { color: #22B573; font-weight: 700; }
.c-ok text { background: #E6F7EF; }
.c-miss { color: #F2555A; }
.c-miss text { background: #FFECEE; }
.c-today { color: #6C4BE8; font-weight: 800; }
.c-today text { box-shadow: inset 0 0 0 3rpx #6C4BE8; }
.c-idle { color: #1C1B22; }
.legend { margin-top: 12rpx; text-align: center; }

.chips { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.chip {
  padding: 8rpx 20rpx; margin: 0 12rpx 12rpx 0; border-radius: 999rpx;
  background: #F4F5F8; color: #6B6A75; font-size: 22rpx;
}
.chip-on { background: #6C4BE8; color: #fff; font-weight: 700; }

.sg { padding: 16rpx 0; border-top: 2rpx solid #F0EFF5; }
.sg:first-child { border-top: none; }
.sg-top { display: flex; justify-content: space-between; align-items: center; }
.sg-n { font-size: 24rpx; font-weight: 700; }
.sg-p { font-size: 21rpx; color: #6C4BE8; font-weight: 700; }
.sg-f { margin-top: 2rpx; }

.field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 2rpx solid #F4F3F8; }
.field:last-child { border-bottom: none; }
.fl { width: 120rpx; font-size: 23rpx; color: #6B6A75; flex: none; }
.fi { flex: 1; font-size: 25rpx; }
